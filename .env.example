# ragU - Local LLM Playground Environment
# Copy to .env and modify as needed

# Ports (all +6 from defaults to avoid collisions)
VITE_PORT=5179
GATEWAY_PORT=3006
RAG_PORT=8006
OLLAMA_PORT=11440
POSTGRES_PORT=5438
QDRANT_REST_PORT=6339
QDRANT_GRPC_PORT=6340

# Ollama
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# PostgreSQL + pgvector
POSTGRES_USER=ragu
POSTGRES_PASSWORD=ragu_local
POSTGRES_DB=ragu

# Vector DB selection: "pgvector", "qdrant", or "hybrid"
VECTOR_DB=pgvector

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# RAG settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Gateway
GATEWAY_HOST=0.0.0.0
RAG_SERVICE_URL=http://rag:8000
OLLAMA_SERVICE_URL=http://ollama:11434

# Frontend
VITE_API_URL=http://localhost:3006
