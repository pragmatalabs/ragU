# ragU Production Environment — Digital Ocean
# Domain: ragu.pragmata.cloud
#
# Copy this to .env before deploying:
#   cp .env.production .env

# ─── Domain & TLS ─────────────────────────────────────────────
DOMAIN=ragu.pragmata.cloud
ACME_EMAIL=admin@pragmata.cloud

# Traefik dashboard auth (generate with: htpasswd -nb admin yourpassword)
# TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$...

# ─── Database ─────────────────────────────────────────────────
POSTGRES_USER=ragu
POSTGRES_PASSWORD=changeme_strong_password_here
POSTGRES_DB=ragu

# ─── MinIO (Object Storage) ──────────────────────────────────
MINIO_ACCESS_KEY=ragu
MINIO_SECRET_KEY=changeme_minio_secret_here

# ─── Vector Store ─────────────────────────────────────────────
# pgvector | qdrant | hybrid
VECTOR_DB=hybrid

# ─── LLM ──────────────────────────────────────────────────────
# Ollama runs inside Docker in production (not native)
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ─── RAG ──────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50
